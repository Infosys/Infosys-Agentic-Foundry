# Base URL for the API server
REACT_APP_BASE_URL=""

# MkDocs base URL
REACT_APP_MKDOCS_BASE_URL=""

# Live tracking URL
REACT_APP_LIVE_TRACKING_URL=""

# Suppress error popup 
REACT_APP_SUPPRESS_404_TOASTS = "true"

# Grafana Dashboard URL
REACT_APP_GRAFANA_DASHBOARD_URL=""

# Microsoft SSO (MSAL) — required for SSO login button
REACT_APP_MSAL_CLIENT_ID=""
REACT_APP_MSAL_AUTHORITY=""
REACT_APP_MSAL_REDIRECT_URI=""
REACT_APP_MSAL_SCOPES=""

# Manual token mode — when enabled, on token expiry the app opens a modal
# for the user to paste a fresh JWT instead of hitting the refresh endpoint.
# Useful for internal gateway environments where the refresh endpoint is
# blocked or unreliable. Truthy values: "true" | "1" | "yes" (case-insensitive).
# Any other value (blank, "false", "0", removed) => disabled. Default: false.
# Runtime override via window._env_ (nginx-injected) wins over build-time value.
REACT_APP_MANUAL_TOKEN_MODE="false"

# Async response mode — when enabled, long-running API calls (agent onboard,
# tool add, chat inference) use async polling instead of blocking the request.
# Required for deployments behind API gateways with strict request timeouts.
# Truthy values: "true" | "1" | "yes" | "on". Default: disabled.
REACT_APP_ASYNC_RESPONSE_MODE=""

# Direct SSO login: when true, the login page auto-redirects to SSO without rendering
REACT_APP_DIRECT_SSO_LOGIN=""