# =============================
# Environment Configuration Template for Infyagentframework
# Copy this file to .env and fill in real values.
# DO NOT COMMIT your populated .env file.
# =============================

## Azure 1
AZURE_OPENAI_API_KEY=""
AZURE_ENDPOINT=""
OPENAI_API_VERSION=""
# Replace the models with the ones available for your api_key (comma seperated string)
AZURE_OPENAI_MODELS="gpt4-8k, gpt-4o-mini, gpt-4o, gpt-35-turbo, gpt-4o-2, gpt-4o-3"

## Azure 2
AZURE_OPENAI_API_KEY_GPT_5=""
AZURE_ENDPOINT_GPT_5=""
OPENAI_API_VERSION_GPT_5=""
# Replace the models with the ones available for your api_key (comma seperated string)
AZURE_OPENAI_GPT_5_MODELS=""


## Additional Azure OpenAI Endpoints (JSON-based, for scaling beyond 2 endpoints)
# Format: JSON array of objects. Each needs: api_key, endpoint, api_version, models (comma-separated)
# Optional keys:
#   - gateway_mode (bool, default: false): Set to true when the endpoint is an LLM gateway/proxy
#     (e.g., Azure API Management, custom proxy). In gateway mode:
#       * The endpoint URL should include the full deployment path
#         (e.g., "https://my-gateway.com/path/deployments/my-model/")
#       * The SDK uses the URL as-is and appends only /chat/completions (no Azure-style path construction)
#       * If "models" is not specified, the model name is auto-extracted from the last URL path segment
#   - models (string, comma-separated): Model name(s) to register for this endpoint.
#     In non-gateway mode, these are used as azure_deployment names.
#     In gateway mode, these are just identifiers; if omitted, the last URL segment is used.
#
# Standard (direct Azure) example:
#   {"api_key":"key1","endpoint":"https://res1.openai.azure.com","api_version":"2024-08-01-preview","models":"gpt-4o,gpt-4o-mini"}
#
# Gateway mode example (model auto-extracted as "isgpt52" from URL):
#   {"api_key":"gw-key","endpoint":"https://my-gateway.com/infygpt52/deployments/isgpt52/","api_version":"2025-01-01-preview","gateway_mode":true}
#
# Gateway mode example (explicit model name override):
#   {"api_key":"gw-key","endpoint":"https://my-gateway.com/path/deployments/isgpt52/","api_version":"2025-01-01-preview","gateway_mode":true,"models":"my-custom-name"}
AZURE_OPENAI_ADDITIONAL_ENDPOINTS='[{"api_key":"your-key-1","endpoint":"https://your-resource-1.openai.azure.com","api_version":"2024-08-01-preview","models":"model-a,model-b","gateway_mode":false},{"api_key":"your-key-2","endpoint":"https://your-resource-2.openai.azure.com","api_version":"2024-08-01-preview","models":"model-c,model-d","gateway_mode":false},{"api_key":"your-key-3","endpoint":"https://your-resource-3.openai.azure.com","api_version":"2024-08-01-preview","models":"model-e","gateway_mode":false}]'


## OpenApi
OPENAI_API_KEY=""
OPENAI_BASE_URL_ENDPOINT="https://api.openai.com/v1"
# Replace the models with the ones available for your api_key (comma seperated string)
OPENAI_MODELS=""
BASE_MODEL_MAPPING=gpt-5.1-chat=gpt-5-chat


## Gemini
GOOGLE_API_KEY=""
# Add the models with the ones available for your api_key (comma seperated string)
GOOGLE_GENAI_MODELS=""

## GPT-OSS
GPT_OSS_BASE_URL_ENDPOINT=""
GPT_OSS_MODELS=""

## Claude via Azure AI Foundry (existing)
# CLAUDE_API_KEY=""              # Azure AI Foundry subscription key
# CLAUDE_ENDPOINT=""             # https://<resource>.services.ai.azure.com/anthropic/
# CLAUDE_DEPLOYMENT_NAME=""      # e.g. claude-sonnet-4-6
# CLAUDE_MODELS=""               # comma-separated, e.g. claude-sonnet-4-6

## Claude via direct Anthropic API (sk-ant-... key, no Azure)
# ANTHROPIC_API_KEY=""           # starts with sk-ant-...
# ANTHROPIC_MODELS=""            # comma-separated, e.g. claude-sonnet-4-6,claude-opus-4-8

## Litellm Proxy
USE_LITELLM_PROXY_FLAG=false
LITELLM_ENDPOINT=""
LITELLM_API_KEY=dummy-key
LITELLM_MODELS=""

DEFAULT_MODEL_NAME="gpt-4o"
# ---------------------------------------------
# LLM Gateway Auth Token Forwarding (Optional)
# When true, forwards the user's Authorization
# header (from MSAL/SSO) to all outgoing LLM API calls.
# Required only when a gateway sits between IAF and the LLM endpoint.
# ---------------------------------------------
LLM_FORWARD_AUTH_TOKEN=false



# Add your frontend IP address
UI_CORS_IP=""
# Add you frontend Ip with port number
UI_CORS_IP_WITH_PORT=""

# Restrict HTTP methods exposed via CORS. true allows only GET/POST/OPTIONS; 
# set to false to allow all methods.
CORS_RESTRICT_METHODS=false

# Update the secrets master key with the output you get by executing generate_master_secret_key.py
SECRETS_MASTER_KEY=""

# Set is as False to disable logging.
ENABLE_LOGGING=True

# Set it as True for OpenTelemetry Collector and tracing. (False in local system)
USE_OTEL_LOGGING=False

# GIVE YOUR POSTGRESQL CONFIG


POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=postgres
# Disables ssl in postgres connection string for inference
DISABLE_SSL_FOR_CHAT_CONNECTIONS=True

# Database name to be used
DATABASE=agentic_workflow_as_service_database
FEEDBACK_LEARNING_DB_NAME=feedback_learning
EVALUATION_LOGS_DB_NAME=evaluation_logs
RECYCLE_DB_NAME=recycle
LOGIN_DB_NAME=login
ARIZE_TRACES_DB_NAME=arize_traces
# keep it 'low' for local devices, change it to 'medium' or 'high' for Server/VM
CONNECTION_POOL_SIZE="low"

PHOENIX_COLLECTOR_ENDPOINT="http://localhost:6006"
PHOENIX_GRPC_PORT="50051"

# The 'server_name' parameter should contain the name of the server or VM where the backend is hosted.
# This helps ensure that logs from different servers can be clearly understood and distinguished.
SERVER_NAME="localhost"

# Redis caching flag
# Before setting this as True make sure that the Redis is setup and the connection config details are done below, or else leave it as False.
ENABLE_CACHING=False      

# Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Setup you redis password here
REDIS_PASSWORD=1234
CACHE_EXPIRY_TIME=900


# Proxy bypass (merged at startup into NO_PROXY; same meaning as no_proxy). Comma-separated hosts.
NO_PROXY_HOSTS=localhost,127.0.0.1
ADDITIONAL_NO_PROXYS=""

# Speech-to-text
STT_ENDPOINT=""
SPEECH_KEY=""
SERVICE_REGION=""


# ---- Authentication / JWT ----
# Strong random secret (32+ chars). Change in production; rotating requires re-issuing existing tokens.
AUTH_JWT_SECRET=""
# Algorithm for JWT signing (e.g., HS256, HS512)
AUTH_JWT_ALGORITHM=HS256
# Access token lifetime in seconds (default 900 = 15 minutes)
AUTH_ACCESS_TOKEN_EXPIRE_SECONDS=900
# Refresh token lifetime in days (default 14)
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=14
# Enable or disable refresh token flow ("true" / "false")
AUTH_ENABLE_REFRESH_TOKENS=true


# ---- IAF MCP Server URLs ----
# Used by IAF KB Server and IAF Enterprise Controller MCP servers.
# IAF_BASE_URL: primary IAF backend base URL (set this in your environment)
# IAF_FALLBACK_BASE_URL: used when IAF_BASE_URL is not set (backup)
IAF_BASE_URL=https://10.77.82.120:5001
IAF_FALLBACK_BASE_URL=https://10.77.82.120:5001

# Embedding/model server used by the Enterprise Controller MCP for semantic tool search.
# MODEL_SERVER_FALLBACK_URL: used when MODEL_SERVER_URL is not set (backup)
MODEL_SERVER_URL=http://10.212.121.151:5500
MODEL_SERVER_FALLBACK_URL=http://10.212.121.151:5500
MODEL_SERVER_HOST=10.212.121.151
MODEL_SERVER_PORT=5500

OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://localhost:4318/v1/traces"
USE_HTTP=True
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT_HTTP="http://localhost:4320/v1/logs"
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT_GRPC="localhost:4319"

# Application Environment Mode
# Set to 'development' for development features (Swagger UI enabled)
# Set to 'production' for production deployment (Swagger UI disabled for security)
ENVIRONMENT=development

# Number of days to retain deleted short-term checkpoints and long-term chats in the recycle bin before permanent deletion
RECYCLE_BIN_RETENTION_DAYS=15

# SMTP / Email Configuration
SMTP_HOST=your-smtp-host
SMTP_PORT=25
SMTP_SENDER_EMAIL_ADDRESS=your-sender-email-address
SMTP_TIMEOUT=3

# Comma-separated emails that should NOT receive admin notification emails
ADMIN_EMAIL_EXCLUDE_LIST=example@infosys.com


STORAGE_PROVIDER=""
AWS_S3_BUKCET_NAME=""
AZURE_BLOB_CONTAINER_NAME=""
AZURE_CONNECTION_STRING=""
# Enable or disable onboarding default tools & agents ("true" / "false")
ENABLE_ONBOARDING =True
# Set to true to create .py files when a tool is onboarded; false to skip tool file creation.
ENABLE_TOOL_FILE_CREATION=false

# Controls whether the backend issues DDL commands (CREATE TABLE, ALTER TABLE,
# CREATE INDEX, etc.) at startup.
# Set to True  in development / first-time setup so tables are auto-created.
# Set to False in production where the DB role lacks DDL privileges and all
# tables have already been created by a migration script or DBA.
ENABLE_CREATE_TABLES=true
# Knowledgebase Server Endpoint
KB_SERVER_ENDPOINT=


# ============================================================================
# Message Queue Configuration
# ============================================================================
# Supported values: "none" (disabled, no MQ — default), "kafka", or "azure_service_bus"
MESSAGE_QUEUE_PROVIDER=none

# Generic topic/queue names (override across providers)
MQ_TOPIC_TOOL_REQUESTS=iaf_tool_call_requests
MQ_TOPIC_TOOL_RESPONSES=iaf_tool_call_responses
MQ_TOPIC_AGENT_REQUESTS=iaf_agent_call_requests

# ---- Kafka Settings (used when MESSAGE_QUEUE_PROVIDER=kafka) ----
# Update the server url with port number
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Set the value to maximum number of pods alloted for agent workers 
KAFKA_AGENT_REQUESTS_PARTITIONS=15
# Set the value to maximum number of pods alloted for tool workers
KAFKA_DEFAULT_PARTITIONS=15
# Set Max Parallel Execution per worker
WORKER_MAX_PARALLEL_EXECUTIONS=10

# Recovery settings for agent worker crash detection
RECOVERY_LOOKBACK_HOURS=24
RECOVERY_RECHECK_MINUTES=30


# ============================================================================
# AZURE SERVICE BUS (when MESSAGE_QUEUE_PROVIDER=azure_service_bus)
# ============================================================================
# Option A: Connection String (simplest, takes priority)
AZURE_SERVICEBUS_CONNECTION_STRING=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=<key>

# Option B: Azure AD Authentication (used when connection string is empty)
# If all three (TENANT_ID + CLIENT_ID + CLIENT_SECRET) are set, ClientSecretCredential is used.
# If only NAMESPACE is set (or CLIENT_ID alone), DefaultAzureCredential is used instead,
# which tries Managed Identity, Azure CLI, VS Code credential, etc.
# Set AZURE_CLIENT_ID alone to hint which user-assigned managed identity to use.
AZURE_SERVICEBUS_NAMESPACE=<namespace>.servicebus.windows.net
AZURE_TENANT_ID=<tenant-id>
AZURE_CLIENT_ID=<client-id>
AZURE_CLIENT_SECRET=<client-secret>

# Service Bus Tuning (optional)
AZURE_SERVICEBUS_MAX_WAIT_TIME=5
AZURE_SERVICEBUS_PREFETCH_COUNT=10


# =============================================================================
# Cron Scheduler Subsystem
# =============================================================================
# Master switch for the background scheduler loop. When false, schedule CRUD
# endpoints still work but no jobs will ever fire.
CRON_SCHEDULER_ENABLED=true

# How often (seconds) each pod polls scheduled_jobs for due jobs.
CRON_POLL_INTERVAL_SECONDS=30

# Maximum number of jobs claimed per poll iteration (per pod).
CRON_MAX_JOBS_PER_POLL=50

# Default IANA timezone applied when a request omits the `timezone` field.
# Examples: Asia/Kolkata, UTC, America/New_York, Europe/London.
CRON_DEFAULT_TIMEZONE=Asia/Kolkata

# Default `max_consecutive_failures` when a schedule is created without one.
# The job is auto-paused after this many consecutive failed dispatches.
CRON_DEFAULT_MAX_CONSECUTIVE_FAILURES=5

# Days of execution history retained in schedule_execution_history.
CRON_HISTORY_RETENTION_DAYS=90

# How often (hours) the history cleanup loop runs.
CRON_HISTORY_CLEANUP_INTERVAL_HOURS=24

# Number of next-fire times returned by the validate-cron preview endpoint.
CRON_VALIDATE_PREVIEW_COUNT=5

# =============================================================================
# SSO / Keycloak
# =============================================================================

# Set to 'false' to disable Keycloak and use local username/password auth only
KEYCLOAK_ENABLED=true

KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=your-realm
KEYCLOAK_CLIENT_ID=your-client-id
KEYCLOAK_CLIENT_SECRET=your-client-secret
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Must match Keycloak -> Client -> Valid Redirect URIs
KEYCLOAK_REDIRECT_URI=http://localhost:8000/auth/callback

# Must match Keycloak -> Client -> Valid Post Logout Redirect URIs
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/login

FRONTEND_REDIRECT_URI=http://localhost:3000
ALLOWED_FRONTEND_URLS=http://localhost:3000

OAUTH_STATE_EXPIRY_SECONDS=600

# MUST be false when MFA is enabled
KEYCLOAK_ALLOW_DIRECT_LOGIN=false

# Options: code (recommended), post, cookie, fragment
OAUTH_TOKEN_DELIVERY_METHOD=code

SESSION_COOKIE_NAME=iaf_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax


# ---------------------------------------------
# Azure AD / MSAL Token Passthrough (Optional)
# Required only when accepting tokens issued by
# an external application via (Azure AD) value should be set to true
# ---------------------------------------------
AZURE_AD_ENABLED=true

# Comma-separated list of Azure AD emails to auto-provision as SuperAdmin on first SSO login.
# Leave empty to use the manual bootstrap endpoint instead.
INITIAL_SUPERADMIN_EMAILS=admin1@company.com,admin2@company.com

# =============================================================================
# Telemetry / Observability Configuration
# =============================================================================

# Azure Application Insights connection string for telemetry export.
# Found in Azure Portal > Application Insights > Overview > Connection String.
# Leave empty to disable Azure telemetry.
APPLICATIONINSIGHTS_CONNECTION_STRING=""

# Telemetry backend to use for LLM observability and tracing.
# Options:
#   azure          - Export traces/metrics to Azure Monitor via Application Insights
#   elasticsearch  - Export traces/metrics to an Elasticsearch cluster
TELEMETRY_BACKEND=azure

# ============================================================================
# Async Response Mode (flag-based long-running endpoint handling)
# Per-pod limits. Total capacity = value x number of pods.
# ============================================================================
# N - max async background tasks executing concurrently per pod
ASYNC_RESPONSE_MAX_RUNNING=100
# M - max async tasks queued (waiting in memory) for a slot per pod. 0 = reject with 429 when full
ASYNC_RESPONSE_MAX_QUEUED=0
# Minutes before a stuck queued/processing task is marked failed by the reaper
ASYNC_RESPONSE_STUCK_TIMEOUT_MINUTES=30
# Hours to retain completed/failed task rows before cleanup deletes them
ASYNC_RESPONSE_RESULT_RETENTION_HOURS=24

# ─────────────────────────────────────────────
# Azure Key Vault Configuration
# ─────────────────────────────────────────────

# List the env var names that should be resolved from vault.
# Their values in .env will be treated as vault secret names (placeholders).
VAULT_ENABLE_KEYS_LIST=

CLIENT_ID=
VAULT_URL=

ENABLE_CHECK_AND_CREATE_DATABASES=
ENABLE_VAULT_DEBUG_LOGS=
ENABLE_DB_DEBUG_LOGS=

# IMPORTANT: Do NOT set SSL_CERT_FILE / REQUESTS_CA_BUNDLE globally. Those force
# EVERY HTTPS client (including GPT) onto this bundle and break GPT calls.
#
# Auto-discovered at ./certs/infosys_ca_bundle_mcp.pem (internal Infosys chain:
# Polycloud-CA -> PPC-CA-NP1 -> InfosysCAMCH -> InfosysLtd). Override explicitly:
INTERNAL_CA_BUNDLE=certs/infosys_ca_bundle_mcp.pem
# optional backward-compatible alias for the same bundle
MCP_SSL_CERT_FILE=  

