# Database Configuration
POSTGRESQL_HOST=''
POSTGRESQL_PORT=''
DATABASE=''
POSTGRESQL_USER=''

# DB password source: set READ_DB_VAULT=true to fetch from Azure Key Vault (see azure_vault/)
READ_DB_VAULT=false
VAULT_URL=
CLIENT_ID=

# When READ_DB_VAULT=true  -> value is the Azure Key Vault secret name
# When READ_DB_VAULT=false -> value is the literal PostgreSQL password
POSTGRESQL_PASSWORD=''

# Model Server Configuration
MODEL_SERVER_URL=''

# KB Server Configuration
KB_SERVER_PORT=8003
XLSX_MAX_ROWS_PER_SHEET=2000    # Max rows per sheet before truncation (raise/lower based on CPU speed)
KB_CHUNK_SIZE=1000              # Characters per chunk (increase for longer context, decrease for precision)
KB_CHUNK_OVERLAP=200            # Overlap between consecutive chunks (preserves context at boundaries)

# Hybrid Search (BM25 + Semantic)
KB_HYBRID_SEARCH_ENABLED=true   # true = BM25 + semantic; false = semantic only
KB_BM25_WEIGHT=0.3              # Weight for BM25 (keyword) score  (must sum to 1.0 with KB_SEMANTIC_WEIGHT)
KB_SEMANTIC_WEIGHT=0.7          # Weight for semantic (embedding) score

HTTP_PROXY=''   # should be empty
HTTPS_PROXY=''  # should be empty

NO_PROXY=''


SSL_CERTFILE=''
SSL_KEYFILE=''

