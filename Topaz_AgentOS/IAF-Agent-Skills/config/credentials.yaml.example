# Credential Store Configuration
# ================================
# Copy this file to credentials.yaml and fill in real values.
# NEVER commit credentials.yaml — it is gitignored.
#
# SECURITY:
# - Set CREDENTIAL_MASTER_KEY env var to encrypt sensitive fields
# - Fields named: token, password, key, secret, api_key will be auto-encrypted
# - Scope limits which skills can access each credential
#
# FORMAT:
# credential_name:
#   type: bearer | basic | api_key
#   token/password/key: "value"  # Will be encrypted on save
#   scope: [skill1, skill2]      # Empty = all skills can access
#   ttl: 3600                    # Optional refresh hint (seconds)
#   metadata:                    # Optional extra config
#     header_name: X-Custom-Key

# Exchange Rate API — multi-currency invoice conversion (P2P)
# Endpoint: https://api.frankfurter.app/latest?from={FROM}&to={TO}
# No API key required for basic use (public tier)
exchangerate_api:
  type: api_key
  key: "PUBLIC_NO_KEY_REQUIRED"
  scope: [invoice_processing_ap, payment_processing, general]
  metadata:
    vendor: frankfurter
    base_url: "https://api.frankfurter.app"
    description: "Live foreign exchange rates for multi-currency invoice conversion"
    example_call: "curl https://api.frankfurter.app/latest?from=EUR&to=USD"

# CloudTech SaaS License API
cloudtech_api:
  type: bearer
  token: "YOUR_CLOUDTECH_TOKEN_HERE"
  scope: [general, invoice_processing_ap]
  ttl: 3600
  metadata:
    vendor: cloudtech
    description: "License and billing API access"

# Example: SAP RFC Connection (basic auth)
# sap_rfc:
#   type: basic
#   username: "svc_ap_agent"
#   password: "your_password_here"
#   scope: [invoice, ar_ops]
#   metadata:
#     system: SAP_PROD

# ITOps Monitoring API (Mock: Datadog-compatible)
# Endpoint: http://localhost:8081/api/mock/itops/*
# Mock server: no real key required; swap base_url + key for real Datadog/ServiceNow in prod
itops_monitoring:
  type: api_key
  key: "YOUR_ITOPS_API_KEY_HERE"
  scope: [disk_triage, itops_parallel_rca, batch_recovery]
  metadata:
    vendor: mock_datadog
    base_url: "http://localhost:8081"
    header_name: "X-API-Key"
    description: "Infrastructure monitoring — disk, metrics, changes, incidents, heap, batch"
    real_vendor_swap: "Replace base_url with https://api.datadoghq.com and key with real DD API key"

# CCD Ops — Kubernetes API
# Token: generate via: kubectl create token node-test-agent --duration=168h
# Regenerate if you receive 401 Unauthorized
ccd_k8s_api:
  type: bearer
  token: "YOUR_KUBERNETES_SERVICE_ACCOUNT_TOKEN_HERE"
  scope: [general, itops_rca]
  ttl: 604800
  metadata:
    vendor: rancher_rke2
    base_url: "https://<CLUSTER_IP>:6443"
    ssl_verify: false
    service_account: "node-test-agent"
    namespace: "default"
    description: "Kubernetes API access for CCD KaaS cluster — RKE2 distribution"
    example_call: "curl -k -H 'Authorization: Bearer <token>' https://<CLUSTER_IP>:6443/version"
