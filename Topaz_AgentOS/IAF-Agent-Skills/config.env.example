# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# OR OpenAI Configuration
# OPENAI_API_KEY=your-api-key-here

# ---- Redis ----
# Required for: cron scheduler (distributed), HITL approvals, JWT blacklist, rate limiting.
# Defaults to localhost:6379. Set this for any non-local Redis (cloud, container, cluster).
# REDIS_URL=redis://localhost:6379

# ---- Storage / Database ----
# Default is SQLite (zero extra deps). Switch to postgres for multi-node / HA.
# DB_BACKEND=postgres
# DATABASE_URL=postgresql://agentpro@localhost:5432/agentpro
#   No inline credential: libpq reads the DB credential from PGPASSWORD or
#   ~/.pgpass, or inject the complete DATABASE_URL from your credential manager.
# DB_POOL_SIZE=10
#
# Knowledge index backend: sqlite (default) | postgres.
# KNOWLEDGE_BACKEND=sqlite

# ---- Vector search ----
# Default is brute_force (exact, in-memory). Switch to pgvector for ANN at scale.
# Requires DB_BACKEND=postgres and `pip install 'psycopg[binary]' pgvector`.
# VECTOR_BACKEND=pgvector
# VECTOR_DIMENSION=1536         # must match your embedding model output size
# PGVECTOR_IVF_LISTS=100        # rule of thumb: sqrt(expected_row_count)

# ---- World model (graph learning) ----
# Graph store backend for the world model. Default: relational.
# GRAPH_BACKEND=relational
# Enable world-model learning writes. Default off (false = zero behaviour change).
# WORLD_MODEL_LEARN=false
# Minimum confidence to record a fact. Default: 0.6.
# WORLD_MODEL_MIN_CONFIDENCE=0.6
# Auto-confirm threshold for learned edges. Empty (default) = off (record as pending).
# WORLD_MODEL_AUTOCONFIRM_CONFIDENCE=

# ---- SQL tool (Postgres graph queries) ----
# Read-only Postgres role the SQL tool connects as. Default: agentos_graph_ro.
# AGENTOS_SQL_RO_ROLE=agentos_graph_ro
# SQL statement timeout in milliseconds. Default: 5000.
# AGENTOS_SQL_STATEMENT_TIMEOUT_MS=5000
