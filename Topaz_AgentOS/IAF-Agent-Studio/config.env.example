# Copy to config.env and fill in values

# Azure OpenAI
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# SSL verification for OpenAI/Azure calls — set false behind Zscaler/corporate proxy, or a CA bundle path
OPENAI_SSL_VERIFY=true

# Data paths
DATA_ROOT=../enterprise_root
SKILLS_PATH=../enterprise_root/tenants/company/skills

# Server
HOST=127.0.0.1
PORT=8081

# Load balancer / reverse proxy — set true when AgentOS is behind an LB (fixes WebSocket "Disconnected")
BEHIND_PROXY=false
# IPs/CIDRs to trust for X-Forwarded-* headers — use * when LB IP is dynamic or unknown
FORWARDED_ALLOW_IPS=127.0.0.1

# Auth cookie Secure flag. Browsers drop Secure cookies over plain HTTP on a
# LAN/IP origin, which silently logs users out (admin pages 401). Leave unset to
# auto-enable Secure only when TLS is in use (SSL_CERTFILE set or BEHIND_PROXY=true);
# set true to force HTTPS-only cookies, or false for plain-HTTP access.
# AUTH_COOKIE_SECURE=false

# Allowed cross-origin origins, comma-separated. Empty = same-origin only.
CORS_ALLOWED_ORIGINS=

# Base path / sub-path prefix — set ONLY when a gateway serves the app under a
# sub-path instead of the domain root, e.g. https://host/qlabs/.
# Empty (default) = served at root "/", behavior unchanged.
# When set (e.g. ROOT_PATH=/qlabs), the app injects the base into the served
# HTML so all API/WebSocket/asset URLs become /qlabs/... AND uvicorn is told its
# root_path. Pair it with a gateway that routes /qlabs/* to this service (with
# WebSocket upgrade on /qlabs/ws/*). Prefer serving at root when possible.
ROOT_PATH=
# Legacy fallback for ROOT_PATH — used only when ROOT_PATH is unset (default empty).
# APP_ROOT_PATH=

# ---- Redis ----
# Required for: cron scheduler (distributed), HITL approvals, JWT blacklist, rate limiting.
# Defaults to localhost:6379. Set this for any non-local Redis (cloud, container, cluster).
# REDIS_URL=redis://localhost:6379
#
# Auth user store backend: "sqlite" (default, portable) | "postgres" (shared DB) | "redis" (HA, multi-node).
# "postgres" persists users in the DATABASE_URL Postgres instance (auth_users/auth_passwords tables).
# WARNING: switching backends does not migrate user accounts. Pick one and keep it.
# AUTH_BACKEND=sqlite
#
# Fail closed when the configured shared store (postgres/redis) is unreachable instead of
# silently falling back to a per-instance SQLite store with no accounts. Defaults to strict
# when a shared backend (postgres/redis) is selected or TLS is in use (SSL_CERTFILE set or
# BEHIND_PROXY=true); leave unset for local SQLite/HTTP dev.
# AUTH_STORE_STRICT=true
#
# Enable Redis-backed session state for horizontal scaling (multi-server deployments).
# USE_REDIS_SESSIONS=false
#
# Task queue backend: "memory" (default, single-server) | "redis" (persistent, multi-node).
# QUEUE_BACKEND=memory

# ---- Route-level entitlements (REV-2) ----
#
# Whether route permission checks consult the tenant policy. While DISABLED
# (the default), every require_scoped_identity permission check resolves to a
# no-op provider that returns "allow" — so destructive actions such as deleting
# a workstream are permitted for ANY authenticated user, with nothing but the
# frontend hiding the control. Enable this to make
# enterprise_root/tenants/${TENANT_ID}/security/policies.yaml authoritative.
#
# Before enabling for a tenant, note two behaviours of the YAML provider
# (security/yaml_provider.py: `if not policies and not ENTITLEMENTS_FAIL_CLOSED`):
#   * Fail-open needs BOTH conditions: zero policies AND
#     ENTITLEMENTS_FAIL_CLOSED=false. Once ANY policy exists, a permission that
#     no policy covers is denied regardless of the fail-closed setting.
#   * ENTITLEMENTS_FAIL_CLOSED defaults to true, so at that default there is no
#     fail-open path at all — enabling this against an empty or missing policy
#     file denies everything and the app will appear broken rather than
#     permissive.
# Verify per role before cutover: the shipped company policy covers the control
# plane, and its only behaviour change is making auditors read-only (with one
# deliberate exception — auditors retain knowledge write for the trace-value
# review flow).
# ENTITLEMENTS_ENABLED=false
# ENTITLEMENTS_PROVIDER=yaml
# ENTITLEMENTS_FAIL_CLOSED=true

# ---- Storage / Database ----
# Default is SQLite (zero extra deps). Switch to postgres for multi-node / HA.
# DB_BACKEND=postgres
# DATABASE_URL=postgresql://agentpro@localhost:5432/agentpro
#   No inline credential: libpq reads the DB credential from PGPASSWORD or
#   ~/.pgpass, or inject the complete DATABASE_URL from your credential manager.
# DB_POOL_SIZE=10
#
# Single storage-mode seam — one knob cascades to every store backend it does not
# already set explicitly (unset = per-store defaults, byte-identical to today).
# STORAGE_MODE=postgres
#
# Trace store backend: sqlite (default) | postgres.
# TRACE_BACKEND=sqlite
#
# Evidence store backend: sqlite (default) | postgres.
# EVIDENCE_BACKEND=sqlite
#
# Postgres schema for traces (postgres backend only). Default: trace.
# TRACE_PG_SCHEMA=trace

# ---- Vector search ----
# Default is brute_force (exact, in-memory). Switch to pgvector for ANN at scale.
# Requires DB_BACKEND=postgres and `pip install 'psycopg[binary]' pgvector`.
# VECTOR_BACKEND=pgvector
# VECTOR_DIMENSION=1536         # must match your embedding model output size
# PGVECTOR_IVF_LISTS=100        # rule of thumb: sqrt(expected_row_count)

# ---- Debug ----
# Set to 1 to flip the platform to DEBUG logging.
# Affects hook subprocess command logs, httpx HTTP req/res, model registry,
# Keycloak/OAuth, and LLM provider routing.
# IAF_DEBUG=0
#
# Optional: pin the Python interpreter used for hook/shell subprocesses.
# Defaults to shutil.which("python3") / which("python") / sys.executable.
# Useful in NSSM where PATH may be sparse, or on Windows where bare
# ``python3.exe`` is typically not on PATH.
# IAF_PYTHON_EXECUTABLE=C:\Users\sai.dharmala\IAF_AgentOS_Harness\venv\Scripts\python.exe

# ---- App version ----
# The app version shown on the login screen/footer. Single source of truth is the
# repo-root `Version` file (e.g. 1.0.0); missing/empty falls back to "dev".
# Set APP_VERSION here only to override the file for ephemeral/CI builds.
# APP_VERSION=

# ---- Privacy notice & declaration gate (default OFF) ----
# First-login Data Privacy notice + declaration/acknowledgement that a user must
# accept before access. Acceptance is persisted to the audit sink
# (PRIVACY_ACK_ACCEPTED). When OFF (default), login/SSO is byte-for-byte unchanged.
# Enable only when a deployment/use-case requires it.
# PRIVACY_ACK_REQUIRED=false
#
# Notice version — bump to force all users to re-accept after the notice changes.
# PRIVACY_NOTICE_VERSION=1.0.0
#
# Title shown at the top of the notice/declaration modal.
# PRIVACY_NOTICE_TITLE=AgentOS-V1.0.0 — Data Privacy Notice & Declaration
#
# Optional path to a custom notice/declaration body (markdown). Absolute path used
# as-is; relative resolved against the server dir. Empty = built-in default notice.
# PRIVACY_NOTICE_PATH=
#
# Comma-separated roles exempt from the gate (break-glass). No role is exempt by
# default — set this to e.g. ``admin`` if you want to keep an admin out of the
# gated flow during rollout. Leave empty to gate every authenticated role.
# PRIVACY_ACK_EXEMPT_ROLES=

# ---- Metrics ----
# Bearer token guarding the /metrics scrape endpoint. Empty (default) = open.
# METRICS_SCRAPE_TOKEN=

# ---- Cron feeder ----
# Base URL the Command Center cron feeder calls. Default: http://localhost:8080.
# STUDIO_URL=http://localhost:8080
# Legacy alias for STUDIO_URL — used only when STUDIO_URL is unset.
# AGENT_STUDIO_URL=http://localhost:8080

# ---- RL capture ----
# Path to the RL capture SQLite DB. Empty (default) = disabled.
# RL_DB_PATH=

# ---- Authentication ----
# Master switch. When false, requests fall back to development identity binding
# and client-supplied tenant/user values are honoured. Never false in a
# deployment reachable by anyone but you.
AUTH_ENABLED=true
# Password-login backend: "local" (Studio-issued JWTs + password login) or
# "microsoft"/"entra"/"azuread"/"azure_ad" (disables password login — Entra is
# the only identity source). Microsoft SSO itself is controlled separately by
# AUTH_MICROSOFT_ENABLED below, so AUTH_PROVIDER=local + AUTH_MICROSOFT_ENABLED=true
# runs password login and "Sign in with Microsoft" side by side.
# AUTH_MICROSOFT_ENABLED=true and KEYCLOAK_ENABLED=true below are MUTUALLY
# EXCLUSIVE — pick exactly one SSO IdP. The server refuses to start if both are set.
AUTH_PROVIDER=local
# Registration policy: open | admin_only | closed.
AUTH_REGISTRATION_MODE=admin_only
# SECRET — generate a unique value per deployment, never reuse or commit one:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Access token lifetime in minutes; the browser refreshes it silently.
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=1
# Maximum session length in hours since login. After this the user must sign
# in again. 0 disables.
# AUTH_SESSION_MAX_HOURS=12
# Idle session timeout, served to the browser via GET /auth/session-policy.
# Warn must stay strictly less than logout or both fall back to 15/20.
SESSION_IDLE_WARN_MINUTES=15
SESSION_IDLE_LOGOUT_MINUTES=20
# One active session per user. When true, a new login from another browser or
# device ends the user's older session. Tabs and windows of the same browser
# share one session. Requires Redis (REDIS_URL).
# AUTH_SINGLE_SESSION=false
# Brute-force controls.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_PER_MINUTE=60
AUTH_LOGIN_RATE_LIMIT=10
# Password policy applied at registration and reset.
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_REQUIRE_UPPERCASE=true
AUTH_PASSWORD_REQUIRE_DIGIT=true
AUTH_PASSWORD_REQUIRE_SPECIAL=true

# ---- Microsoft Entra ID / MSAL SSO (optional) ----
# Independent bolt-on — works with AUTH_PROVIDER=local (password login stays
# available) or AUTH_PROVIDER=microsoft. Mutually exclusive with Keycloak below.
# AUTH_MICROSOFT_ENABLED=true
# AUTH_MICROSOFT_TENANT_ID=
# AUTH_MICROSOFT_CLIENT_ID=
# AUTH_MICROSOFT_CLIENT_SECRET=
# MSAL_SCOPES=openid profile email   # id_token is signed by tenant JWKS; backend can verify it
# Scheme+host(+port) only — the path is always normalized to the standard
# SSO callback (/auth/callback, the same fixed route Keycloak uses) regardless
# of what path is given here. Must still be registered in Azure AD as
# "<this origin>/auth/callback".
# MSAL_REDIRECT_URI=http://localhost:8081/auth/callback

# ---- Keycloak / SSO (optional) ----
# Mutually exclusive with Microsoft/MSAL above — requires AUTH_MICROSOFT_ENABLED=false (or unset).
# KEYCLOAK_ENABLED=false
# KEYCLOAK_SERVER_URL=https://keycloak.example.com
# KEYCLOAK_REALM=your-realm
# KEYCLOAK_CLIENT_ID=agentos
# SECRET — do not commit a real value.
# KEYCLOAK_CLIENT_SECRET=
# Fixed standard SSO callback path — same route MSAL's redirect normalizes onto.
# KEYCLOAK_REDIRECT_URI=https://your-host/auth/callback
# Fixed standard SSO callback path — same route MSAL's redirect normalizes onto.
# KEYCLOAK_REDIRECT_URI=https://your-host/auth/callback
# KEYCLOAK_POST_LOGOUT_REDIRECT_URI=https://your-host/static/login.html
# Set false ONLY for a self-signed dev IdP.
# KEYCLOAK_VERIFY_SSL=true
# SSO session bounds (provider=keycloak users only):
# KEYCLOAK_SESSION_MAX_TTL_MINUTES=480
# KEYCLOAK_OFFLINE_SESSION_TTL_MINUTES=60
# KEYCLOAK_REACHABILITY_CACHE_SECONDS=30

# ---- Credential vault ----
# SECRET — encrypts stored external credentials at rest. Losing this makes every
# stored credential unrecoverable; rotating it requires re-entering them all.
CREDENTIAL_MASTER_KEY=

# ---- HashiCorp Vault (optional) ----
# Vault CONNECTIONS are configured per-connection in the Credentials UI (stored in
# credentials.yaml as `type: vault`, scoped to specific skills). Each connection
# holds its own Vault address, namespace, KV mount, and AppRole (role_id/secret_id)
# or static token — so none of that belongs here. Skills read secrets live by
# path/key, e.g. ${VAULT:my_vault@some/path#field}. Secrets never reach the LLM/logs.
#
# The only Vault settings that belong in this file are TLS trust, used whenever the
# platform connects to Vault. Leave VAULT_CA_BUNDLE blank on Windows to auto-use the
# Windows trust store; otherwise point it at a PEM bundle containing the Vault CA.
# VAULT_CA_BUNDLE=
# VAULT_SSL_VERIFY=true
#
# Legacy: a single global env-configured Vault backend still exists as an optional
# fallback, toggled by VAULT_ENABLED (its VAULT_ADDR/VAULT_ROLE_ID/… vars are
# documented in agent_os/credential_store.py). Prefer the per-connection model above.
# VAULT_ENABLED=false

# ---- Model providers ----
# Pick a primary and an optional fallback/light tier. Leave a block commented to
# disable that provider. API keys are SECRETS — never commit real values.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL_NAME=gpt-4o
# OPENAI_MODEL_NAME_FALLBACK=gpt-4o-mini
# OPENAI_MODEL_NAME_LIGHT=gpt-4o-mini
# OPENAI_TEMPERATURE=0.2
#
# AZURE_OPENAI_DEPLOYMENT_FALLBACK=gpt-4o-mini
# AZURE_OPENAI_DEPLOYMENT_LIGHT=gpt-4o-mini
#
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_NAME=claude-opus-4-6
# ANTHROPIC_MODEL_NAME_FALLBACK=claude-sonnet-4-5
# ANTHROPIC_MODEL_NAME_LIGHT=claude-haiku-4-5
# ANTHROPIC_MAX_TOKENS=8192
# ANTHROPIC_TEMPERATURE=0.2
# ANTHROPIC_SSL_VERIFY=true
# ANTHROPIC_CA_BUNDLE=
# Expose/replay model reasoning across calls.
ANTHROPIC_REASONING_EXPOSE=true
ANTHROPIC_REASONING_REPLAY=true
#
# VERTEX_PROJECT=
# VERTEX_LOCATION=us-central1
# VERTEX_SA_KEY_PATH=/path/to/service-account.json
# VERTEX_TEMPERATURE=0.2
# VERTEX_CA_BUNDLE=
#
# Provider routing, if you prefer explicit tiers over per-provider blocks.
# LLM_PRIMARY_PROVIDER=azure
# LLM_PRIMARY_MODEL=gpt-4o
# LLM_FALLBACK_PROVIDER=openai
# LLM_FALLBACK_MODEL=gpt-4o-mini
# LLM_LIGHT_PROVIDER=openai
# LLM_LIGHT_MODEL=gpt-4o-mini
# LLM_LIGHT_BASE_URL=

# ---- Agent runtime ----
IAF_REACT_RUNTIME=true
# Re-check a critique pass before finalising an answer.
CRITIQUE_RECHECK=true
CONSISTENCY_CHECK=true
# Python tool sandbox. SECURITY: set AGENT_PYTHON3_SANDBOX_USER to a restricted
# OS user in production; running as the server user gives tools its privileges.
AGENT_PYTHON3_ENABLED=true
AGENT_PYTHON3_TIMEOUT=30
AGENT_PYTHON3_MAX_MEMORY_MB=512
AGENT_PYTHON3_SANDBOX_USER=

# ---- Knowledge backend ----
# sqlite (default, portable) | postgres (shared, multi-node).
KNOWLEDGE_BACKEND=sqlite

# ---- Command Center queue ----
QUEUE_POLL_INTERVAL=2
QUEUE_MAX_CONCURRENT_JOBS=8
# Seconds a single skill may run. 0 = no limit.
QUEUE_SKILL_TIMEOUT_SEC=0
QUEUE_DEFAULT_TENANT=company
# Auto-seed demo items on startup. Keep false outside a demo.
QUEUE_SEED_DEMO=false
# NB: values containing spaces must be quoted. shared/config.py loads this file
# with dotenv, which handles them, but `source config.env` in a shell does not —
# it tries to execute the second word as a command.
QUEUE_HEADER_TITLE="CCD Operations"
QUEUE_DOMAIN_LABEL="Accounts Payable"
# SECRET — guards the queue ingest endpoint.
QUEUE_INGEST_API_KEY=
# IAF_QUEUE_INGEST_URL=http://localhost:8080/api/queue/ingest
# CC_QUEUE_STORAGE_BACKEND=sqlite

# ---- Public URL ----
# Absolute base URL the server advertises in links and callbacks.
SERVER_BASE_URL=http://localhost:8080

# ---- Corporate proxy / TLS ----
# Set these behind Zscaler or a TLS-inspecting proxy, or handshakes fail.
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# Hosts to bypass the proxy for.
CURL_NOPROXY=localhost,127.0.0.1
# CA bundle used by requests/curl/python-ssl respectively.
REQUESTS_CA_BUNDLE=
CURL_CA_BUNDLE=
SSL_CERT_FILE=
# MCP_SSL_VERIFY=true
# Server-side TLS. Leave unset to serve plain HTTP behind a terminating proxy.
# SSL_CERTFILE=/path/to/cert.pem
# SSL_KEYFILE=/path/to/key.pem

# ---- Check Point integration (optional) ----
# CHECKPOINT_MGMT_HOST=
# CHECKPOINT_MGMT_PORT=443
# SECRET — do not commit a real value.
# CHECKPOINT_API_KEY=
