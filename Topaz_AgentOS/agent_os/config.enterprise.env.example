# AgentPro dedicated-enterprise production baseline.
# Copy to a secret-managed deployment environment; never commit real values.

ENTERPRISE_STRICT_MODE=true
TENANT_ID=replace_enterprise_id
AGENT_ID=enterprise_agent
HOST=0.0.0.0
PORT=8080

# Run three process types with the same image and a role-specific override:
# API: STUDIO_RUNTIME_ROLES=api
# Scheduler: STUDIO_RUNTIME_ROLES=scheduler
# Queue: STUDIO_RUNTIME_ROLES=queue
STUDIO_RUNTIME_ROLES=api
UVICORN_WORKERS=2
QUEUE_WORKER_REPLICAS=1
# Keep sqlite for the initial P0 rollout. After migrating command_center.db and
# verifying one Postgres worker, set CC_QUEUE_STORAGE_BACKEND=postgres and raise
# QUEUE_WORKER_REPLICAS only on queue-role deployments.
CC_QUEUE_STORAGE_BACKEND=sqlite
CC_QUEUE_DATABASE_URL=
QUEUE_CLAIM_LEASE_SECONDS=360
QUEUE_CLAIM_RECLAIM_LIMIT=3
QUEUE_WORKER_HEARTBEAT_TTL_SECONDS=30
SCHEDULER_LEADER_LOCK_TTL_SECONDS=45
SCHEDULER_LEADER_RETRY_SECONDS=5

# Identity and authorization. Start observe-only, investigate would-deny audit
# rows, then change ENTITLEMENTS_ENFORCEMENT_MODE to enforce.
AUTH_ENABLED=true
AUTH_PROVIDER=oidc
AUTH_OIDC_ISSUER=https://replace-idp.example.com/
AUTH_OIDC_AUDIENCE=replace-client-id
AUTH_OIDC_JWKS_URL=https://replace-idp.example.com/.well-known/jwks.json
ENTITLEMENTS_ENABLED=true
ENTITLEMENTS_PROVIDER=yaml
ENTITLEMENTS_FAIL_CLOSED=true
ENTITLEMENTS_ENFORCEMENT_MODE=observe
ENTITLEMENTS_AUDIT_ENABLED=true

# One active session per user. When true, a new login from another browser or
# device ends the user's older session. Tabs and windows of the same browser
# share one session. Requires Redis (REDIS_URL).
# AUTH_SINGLE_SESSION=false
# Maximum session length in hours since login. After this the user must sign
# in again. 0 disables.
# AUTH_SESSION_MAX_HOURS=12

# Operational surfaces.
DEMO_PUBLIC_SURFACES=false
QUEUE_INGEST_API_KEY=replace-with-32-byte-random-secret
FILE_URL_SIGNING_SECRET=replace-with-32-byte-random-secret
FILE_URL_TTL_SECONDS=300
ALLOW_UNSIGNED_FILE_URLS=false

# External access fails closed after observe-mode policy validation.
EXTERNAL_ACCESS_ENABLED=true
EXTERNAL_ACCESS_UNKNOWN_MODE=deny
EXTERNAL_ACCESS_ENFORCE_CREDENTIALS=true
EXTERNAL_ACCESS_ENFORCE_MCP=true
EXTERNAL_ACCESS_ENFORCE_SQL=true

# Redis must use TLS/auth and persistence in production. The ACL user and
# credential are never written here: inject the complete REDIS_URL (including
# its ACL user/credential) from your credential manager at deploy time.
REDIS_URL=rediss://replace-redis:6380/0
QUEUE_BACKEND=redis
# Required by strict API roles. Startup and /health/ready fail closed when the
# shared session store cannot be reached.
USE_REDIS_SESSIONS=true

# P0 starts with one queue worker on SQLite. API horizontal scaling is
# read/session safe. Queue-role scaling requires DB_BACKEND=postgres plus
# CC_QUEUE_STORAGE_BACKEND=postgres.
DB_BACKEND=sqlite
VECTOR_BACKEND=brute_force

# Agent Python is optional. If enabled, provision the restricted Linux account
# and sudoers/ACL profile documented in ENTERPRISE_OPERATIONS_PROFILE.md.
AGENT_PYTHON3_ENABLED=false
AGENT_PYTHON3_SANDBOX_USER=agentpro_python
AGENT_PYTHON3_TIMEOUT=30
AGENT_PYTHON3_MAX_MEMORY_MB=512

# TLS is normally terminated at the enterprise ingress. If Studio terminates
# TLS directly, set both paths.
SSL_CERTFILE=
SSL_KEYFILE=

# Use an explicit enterprise origin at ingress; do not expose Studio directly.
CORS_ALLOWED_ORIGINS=https://agentpro.replace-enterprise.example

# Telemetry and backup paths must be connected to enterprise-owned services.
TRACE_TELEMETRY=true
TWIN_TELEMETRY=true
TELEMETRY_EXPORTERS=local,otlp
TELEMETRY_OTLP_ENDPOINT=https://replace-collector.example.com/v1/logs
AUDIT_EVIDENCE_MIRROR_ENABLED=true
AUDIT_EVIDENCE_MIRROR_DIR=/var/lib/agentpro/audit-mirror

# Recovery Readiness reads only from a separately restored data root. Never
# point this at DATA_ROOT or a parent/child of DATA_ROOT.
RECOVERY_VERIFICATION_ROOT=/var/lib/agentpro/recovery-cell/data
RECOVERY_RUNTIME_RPO_TARGET_MINUTES=15
RECOVERY_RPO_TARGET_MINUTES=60
RECOVERY_RTO_TARGET_MINUTES=240
# Optional read-only probes for a separately started recovery cell. Keep the
# token in the secret manager and use a Redis host/port distinct from REDIS_URL.
RECOVERY_LIVE_BASE_URL=
RECOVERY_REDIS_URL=
RECOVERY_LIVE_TOKEN=
RECOVERY_LIVE_CONFIRMATION=
RECOVERY_LIVE_TIMEOUT_SECONDS=5

# Disable sample data.
QUEUE_SEED_DEMO=false
