# IAF AgentOS — Environment Configuration
# =========================================
# Copy this file to config.env and fill in real values.
# NEVER commit config.env — it is gitignored.
#
# See docs/AGENTPRO_SETUP.md for full setup instructions.

# ── Server ─────────────────────────────────────────────────────────
# 0.0.0.0 makes server accessible from other machines on the network
HOST=0.0.0.0
PORT=8081

# Reverse proxy / load balancer — set BEHIND_PROXY=true when behind an LB or
# gateway (fixes WebSocket "Disconnected"). FORWARDED_ALLOW_IPS = IPs/CIDRs to
# trust for X-Forwarded-* headers; use * when the LB IP is dynamic/unknown.
BEHIND_PROXY=false
FORWARDED_ALLOW_IPS=127.0.0.1

# Sub-path / base-path prefix — set ONLY when a gateway serves the app under a
# sub-path (e.g. https://host/qlabs/ -> ROOT_PATH=/qlabs). Empty = served at root "/".
ROOT_PATH=

# Allowed cross-origin origins, comma-separated. Empty = same-origin only.
CORS_ALLOWED_ORIGINS=

# Absolute base URL the server advertises in links/callbacks.
SERVER_BASE_URL=http://localhost:8081

# Router-selected multi-step orchestration (default true).
# Set false for a temporary fallback to normal ReAct; restart Studio afterward.
DYNAMIC_ORCHESTRATOR_ENABLED=true

# ReAct runtime: native (direct provider calls, captures thinking blocks) | langgraph (default).
IAF_REACT_RUNTIME=native
# Max native-ReAct tool-calling turns before falling back to LangGraph (default 8).
# IAF_REACT_NATIVE_MAX_ITERATIONS=40

# ── Data paths ─────────────────────────────────────────────────────
# DATA_ROOT is the tenant tree root; SKILLS_PATH is the skill discovery root.
# Both default to the real enterprise_root tree (relative to IAF-Agent-Studio/).
DATA_ROOT=../enterprise_root
SKILLS_PATH=../enterprise_root/tenants/company/skills

# ── Redis ──────────────────────────────────────────────────────────
# Format: redis://:<password>@<host>:<port>
# No password: redis://localhost:6379
REDIS_URL=redis://:<YOUR_REDIS_PASSWORD>@localhost:6379
USE_REDIS_SESSIONS=true

# TLS — set both to serve Studio over HTTPS (https://HOST:PORT).
# Ready-to-use dev cert/key ship in agent_os/certs/. Replace with your own
# CA-signed cert/key for production. Leave both blank/commented for plain HTTP.
# SSL_CERTFILE=../agent_os/certs/fullchain.pem
# SSL_KEYFILE=../agent_os/certs/privatekey.pem

# ── LLM Configuration ──────────────────────────────────────────────
#
# Four modes — uncomment the block that applies. Only one block active at a time.
#
# Runtime active-provider override (also set by PUT /api/llm/providers/active).
# When set to a concrete provider it takes precedence over the Mode 1/2/3
# auto-detection below. Valid values: azure | openai | vertex | anthropic.
# Empty (default) = auto-detect from the mode blocks below.
# LLM_ACTIVE_PROVIDER=
#
# MODE 1: Per-role hybrid (mix Azure + OpenAI-compatible + Vertex AI per role)
# ─────────────────────────────────────────────────────────────────────────────
# LLM_PRIMARY_PROVIDER=azure              # values: azure | openai | vertex
# LLM_PRIMARY_MODEL=gpt-4o                 # REQUIRED — deployment/model name; without it LLM calls return 500
# LLM_LIGHT_PROVIDER=openai
# LLM_LIGHT_MODEL=google/gemma-3-27b
# LLM_LIGHT_BASE_URL=http://<vllm-host>:8004/v1
# LLM_FALLBACK_PROVIDER=azure
# LLM_FALLBACK_MODEL=gpt-4o-mini
#
# MODE 2: OpenAI-compatible only (Gemma, Ollama, vLLM, OpenAI direct, Gemini…)
# ─────────────────────────────────────────────────────────────────────────────
# OPENAI_BASE_URL=http://<vllm-host>:8004/v1
# OPENAI_MODEL_NAME=google/gemma-3-27b
# OPENAI_API_KEY=none
# OPENAI_TEMPERATURE=0.7
# OPENAI_MODEL_NAME_LIGHT=google/gemma-3-27b
# OPENAI_MODEL_NAME_FALLBACK=google/gemma-3-27b
#
# MODE 2b: Gemma via vLLM over corporate HTTPS (Zscaler / SSL inspection)
# ─────────────────────────────────────────────────────────────────────────────
# Same OpenAI-compatible path, but the vLLM endpoint is HTTPS behind a corporate
# CA. The builder (_build_openai) reads these directly:
# OPENAI_BASE_URL=https://<vllm-host>:8004/v1
# OPENAI_MODEL_NAME=google/gemma-4-31B-it
# OPENAI_MODEL_NAME_LIGHT=google/gemma-4-31B-it
# OPENAI_MODEL_NAME_FALLBACK=google/gemma-4-31B-it
# OPENAI_API_KEY=<VLLM_API_KEY>            # your vLLM server's API key
# OPENAI_TEMPERATURE=0.2
# SSL: set OPENAI_SSL_VERIFY to the corporate CA bundle PATH. A file path makes
# _get_ssl_verify() use it as the trust store (equivalent to httpx verify=<pem>).
# Use 'false' ONLY for local/dev endpoints you don't want validated.
# OPENAI_SSL_VERIFY=/path/to/corporate-ca-bundle.pem
#
# MODE 3: Azure OpenAI only (default, active when no LLM_* or OPENAI_BASE_URL set)
# ─────────────────────────────────────────────────────────────────────────────
AZURE_OPENAI_API_KEY="YOUR_AZURE_OPENAI_API_KEY_HERE"
AZURE_OPENAI_ENDPOINT="https://<YOUR_RESOURCE_NAME>.openai.azure.com/"
AZURE_OPENAI_API_VERSION="2024-12-01-preview"
AZURE_OPENAI_DEPLOYMENT="gpt-4o"
AZURE_OPENAI_DEPLOYMENT_LIGHT="gpt-4o-mini"
AZURE_OPENAI_DEPLOYMENT_FALLBACK="gpt-4o-mini"
# Azure egress SSL — priority in model_registry._get_public_ssl_verify():
#   AZURE_SSL_VERIFY -> AZURE_CA_BUNDLE -> PUBLIC_CA_BUNDLE -> default trust store.
#   AZURE_SSL_VERIFY: true (default) | false (skip — INSECURE) | /path/to/ca.pem
#   AZURE_CA_BUNDLE : absolute path to a CA bundle (public roots + proxy interception CA)
# AZURE_SSL_VERIFY=true
# AZURE_CA_BUNDLE=
#
# MODE 4: Google Vertex AI Gemini (uses service-account auth, no API key)
# ─────────────────────────────────────────────────────────────────────────────
# Activate by setting LLM_PRIMARY_PROVIDER=vertex (in MODE 1 hybrid block above)
# Then set:
# VERTEX_PROJECT=iaf-madhan              # GCP project id
# VERTEX_LOCATION=us-central1            # GCP region (default us-central1)
# VERTEX_SA_KEY_PATH=/path/to/sa-key.json   # Service account JSON file
# VERTEX_MODEL_NAME=gemini-2.5-flash        # default Vertex model id (default "" — required for provider=vertex)
# VERTEX_CA_BUNDLE=/tmp/combined_ca_bundle.pem   # Optional: corporate CA bundle for
#                                                  Zscaler / proxy SSL inspection
# VERTEX_TEMPERATURE=0.7                 # default 0.7
#
# Models tested working in iaf-madhan: gemini-2.5-flash, gemini-2.5-pro
# Older models (gemini-1.5-*, gemini-2.0-*) return 404 if not enabled in project.
#
# MODE 5: Anthropic Claude (uses API key from console.anthropic.com)
# ─────────────────────────────────────────────────────────────────────────────
# Activate by setting LLM_PRIMARY_PROVIDER=anthropic (in MODE 1 hybrid block above)
# Then set:
# ANTHROPIC_API_KEY=sk-ant-your-key-here       # API key from console.anthropic.com
# ANTHROPIC_MODEL_NAME=claude-sonnet-4-20250514 # default Anthropic model id (required for provider=anthropic)
# ANTHROPIC_TEMPERATURE=0.7                    # default 0.7
# ANTHROPIC_MAX_TOKENS=4096                    # default 4096
# ANTHROPIC_MODEL_NAME_FALLBACK=claude-sonnet-4-5   # fallback-tier model
# ANTHROPIC_MODEL_NAME_LIGHT=claude-haiku-4-5       # light/background-tier model
# ANTHROPIC_SSL_VERIFY=true                    # 'false' or a CA-bundle path behind a TLS-inspecting proxy
# ANTHROPIC_CA_BUNDLE=                         # explicit CA bundle path for Anthropic egress
#
# Models: claude-sonnet-4-20250514, claude-opus-4-20250514, claude-3-5-haiku-20241022
#
# Example hybrid config:
#   LLM_PRIMARY_PROVIDER=anthropic
#   LLM_PRIMARY_MODEL=claude-sonnet-4-20250514
#   LLM_LIGHT_PROVIDER=anthropic
#   LLM_LIGHT_MODEL=claude-3-5-haiku-20241022

# ── Native Reasoning (opt-in per provider) ─────────────────────────
# Enable model-native reasoning traces (Azure Responses API, Claude thinking,
# Gemini thinkingConfig). Off by default — adds latency and token cost.
#
# Azure (o1/o3/o4/gpt-5 via Responses API):
# AZURE_REASONING_ENABLED=true               # master switch for Azure reasoning
# AZURE_REASONING_EFFORT=medium              # low | medium | high
# AZURE_REASONING_REPLAY=true                # cross-call reasoning continuity
# AZURE_REASONING_EXPOSE=true                # show reasoning preview in UI
#
# Anthropic Claude (thinking blocks):
# ANTHROPIC_REASONING_REPLAY=true            # reasoning continuity across calls
# ANTHROPIC_REASONING_EXPOSE=true            # show thinking preview in UI
#
# Google Vertex / Gemini (thinkingConfig):
# VERTEX_REASONING_REPLAY=true               # reasoning continuity across calls
# VERTEX_REASONING_EXPOSE=true               # show thinking preview in UI

# ── Knowledge backend ──────────────────────────────────────────────
# Structured knowledge/memory index store: sqlite (default, portable) | postgres (shared, multi-node).
KNOWLEDGE_BACKEND=sqlite

# ── Knowledge Index Embeddings ─────────────────────────────────────
# Semantic (vector) search over the knowledge/memory index. This feature is
# Azure OpenAI ONLY — it is independent of LLM_ACTIVE_PROVIDER and does NOT use
# the OpenAI-compatible (Gemma/vLLM), Vertex, or Anthropic providers.
#
# Behaviour (see IAF-Agent-Skills/iaf_agent_skills/memory.py _create_embedding_fn):
#   1. If KNOWLEDGE_EMBEDDINGS_ENABLED is false/0/no/off -> embeddings OFF,
#      the indexer runs FTS5 keyword-only mode (no per-query embedding call).
#   2. Else if AZURE_OPENAI_API_KEY or AZURE_OPENAI_ENDPOINT is missing ->
#      auto-fallback to FTS5 keyword-only mode.
#   3. Else -> semantic embeddings via Azure using AZURE_OPENAI_EMBEDDING_MODEL.
#
# Keep this false on air-gapped/intranet hosts where Azure is unreachable —
# otherwise each query blocks ~30s on the embedding round-trip before failing.
KNOWLEDGE_EMBEDDINGS_ENABLED=false
# Azure embedding DEPLOYMENT name (must exist on your Azure resource).
# Default when unset: text-embedding-ada-002 (1536-dim -> matches VECTOR_DIMENSION).
# AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# In-memory LRU cache size for embedding vectors (~12KB each; 4096 ~= 48MB).
# EMBEDDING_CACHE_MAX_SIZE=4096

# ── Credential Store Encryption ────────────────────────────────────
# Master key for encrypting credentials.yaml at rest (Fernet AES-128).
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().hex())"
# Keep this secret — losing it means credentials cannot be decrypted.
CREDENTIAL_MASTER_KEY=YOUR_64_CHAR_HEX_KEY_HERE

# ── Authentication ─────────────────────────────────────────────────
# Registration mode: open | approval | admin_only
AUTH_REGISTRATION_MODE=admin_only
AUTH_ENABLED=true
AUTH_PROVIDER=local
AUTH_BACKEND=redis
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=YOUR_64_CHAR_HEX_JWT_SECRET_HERE
# Access token lifetime in minutes; the browser refreshes it silently.
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=1
# Maximum session length in hours since login. After this the user must sign
# in again. 0 disables.
# AUTH_SESSION_MAX_HOURS=12
# One active session per user. When true, a new login from another browser or
# device ends the user's older session. Tabs and windows of the same browser
# share one session. Requires Redis (REDIS_URL).
# AUTH_SINGLE_SESSION=false
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_PER_MINUTE=60
AUTH_LOGIN_RATE_LIMIT=10
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_REQUIRE_UPPERCASE=true
AUTH_PASSWORD_REQUIRE_DIGIT=true
AUTH_PASSWORD_REQUIRE_SPECIAL=true

# ── Microsoft Entra / MSAL SSO (optional) ──────────────────────────
# Set AUTH_PROVIDER=microsoft to enable. A single app registration serves both
# the frontend (MSAL) and backend; MSAL config is served at GET /auth/msal/config.
# AUTH_PROVIDER=microsoft
AUTH_MICROSOFT_TENANT_ID=
AUTH_MICROSOFT_CLIENT_ID=
# id_token is signed by the tenant JWKS; the backend verifies it.
MSAL_SCOPES=openid profile email
# Must be registered as a redirect URI in Azure AD, e.g. https://<your-host>/auth-callback
MSAL_REDIRECT_URI=

# ── Command Center (Autonomous Queue Processor) ─────────────────────
# Task queue backend: memory (default, single-server) | redis (persistent, multi-node).
# QUEUE_BACKEND=memory
QUEUE_POLL_INTERVAL=2               # seconds between queue polls
QUEUE_MAX_CONCURRENT_JOBS=8         # max parallel skill executions
QUEUE_SKILL_TIMEOUT_SEC=300         # max seconds a single skill can run (0 = no limit)
QUEUE_DEFAULT_TENANT=company        # default tenant for queue processing
QUEUE_SEED_DEMO=false               # set true to auto-seed demo items on startup
AUTH_SEED_ADMIN_ON_STARTUP=false    # set true to auto-create admin@iaf.local on startup (dev only)
IAF_ADMIN_PASSWORD=                 # required when AUTH_SEED_ADMIN_ON_STARTUP=true — set a strong password
QUEUE_DOMAIN_LABEL=Ticket
QUEUE_HEADER_TITLE=CCD Operations
# API key for POST /api/queue/ingest (empty = open, no auth required)
QUEUE_INGEST_API_KEY=

# ── Untrusted multi-tenant execution guard ─────────────────────────
# Set true when this deployment serves UNTRUSTED end-users (e.g. a shared 100K-user
# SaaS). When true, tenant-reachable arbitrary-code execution is forced OFF regardless
# of AGENT_PYTHON3_ENABLED — `python3 <...>` in the agent shell becomes a blocked
# command. The pure-Python command surface (ls/cat/grep/head/tail/find/wc/...) is
# unaffected. Default false = trusted single-tenant behaviour (no change).
AGENTOS_UNTRUSTED_EXECUTION_GUARD=false

# ── Python3 Execution (agent shell) ────────────────────────────────
# Allows agents to run python3 -c "..." in shell commands.
# SECURITY: set AGENT_PYTHON3_SANDBOX_USER to a restricted OS user for production.
# NOTE: ignored (forced off) when AGENTOS_UNTRUSTED_EXECUTION_GUARD=true.
# Setup: sudo useradd --system --no-create-home --shell /usr/sbin/nologin agent_sandbox
AGENT_PYTHON3_ENABLED=true
AGENT_PYTHON3_SANDBOX_USER=
AGENT_PYTHON3_TIMEOUT=30
AGENT_PYTHON3_MAX_MEMORY_MB=512

# ── Proxy Bypass (Zscaler / corporate proxy) ───────────────────────
# Comma-separated list of HOSTNAMES that curl should reach directly,
# bypassing any HTTP_PROXY / HTTPS_PROXY env vars set by Zscaler or the OS.
#
# Important: curl --noproxy matches by hostname only — it does NOT support
# CIDR ranges (e.g. 10.0.0.0/8 will NOT bypass for IPs in that range).
# Use hostname suffixes or '*'. The only wildcard is '*'.
# Use '*' alone to bypass the proxy for ALL curl calls.
#
# Examples:
#   CURL_NOPROXY=localhost,127.0.0.1,*.internal.corp.com,*.infosys.com
#   CURL_NOPROXY=*       # bypass proxy entirely (use with caution)
CURL_NOPROXY=localhost,127.0.0.1

# Hard timeout (seconds) the kernel applies to every agent-issued curl call — both
# curl --max-time and the subprocess/pipeline watchdog. Default 30, clamped to [5, 600].
# CURL_TIMEOUT=30

# ── Corporate Proxy (reach PUBLIC endpoints, e.g. Azure OpenAI) ─────
# Route OUTBOUND traffic through the corporate proxy to reach the public
# internet from an intranet host. httpx/requests honor these automatically.
# List every intranet host in NO_PROXY so it stays DIRECT (bypasses the proxy)
# — otherwise local LLM (vLLM/Gemma), Redis, Postgres, Keycloak break.
# Leave blank/commented when no proxy is required (direct internet or air-gapped).
# HTTP_PROXY=http://<proxy-host>:<port>
# HTTPS_PROXY=http://<proxy-host>:<port>
# NO_PROXY=localhost,127.0.0.1,::1,<vllm-host>,.internal,.corp.com

# ── Corporate CA trust (Zscaler / SSL inspection) ──────────────────
# Point Python's ssl, the requests library, and curl at the corporate CA bundle
# so ALL outbound HTTPS (LLM calls, API tools, agent curl steps) trusts the
# inspected chain. Standard env vars each library reads automatically — set to
# the absolute path of your .pem bundle. (For the LLM path specifically, prefer
# OPENAI_SSL_VERIFY=<pem> above, which the builder passes as an explicit verify.)
# SSL_CERT_FILE=/path/to/corporate-ca-bundle.pem
# REQUESTS_CA_BUNDLE=/path/to/corporate-ca-bundle.pem
# CURL_CA_BUNDLE=/path/to/corporate-ca-bundle.pem
#
# Model-registry egress CA bundles (used by model_registry.py / memory.py).
# CA bundle for PUBLIC / proxy-intercepted LLM egress (public roots + proxy CA).
# PUBLIC_CA_BUNDLE=/path/to/public-ca-bundle.pem
# CA bundle for DIRECT internal model egress (internal-only trust store).
# INTERNAL_CA_BUNDLE=/path/to/internal-ca-bundle.pem

CONSISTENCY_CHECK=false
CRITIQUE_RECHECK=false

# ── Storage / Database ─────────────────────────────────────────────
# Default is SQLite (zero extra deps). Switch to postgres for multi-node / HA.
# DB_BACKEND=postgres
# DATABASE_URL=postgresql://agentpro@localhost:5432/agentpro
#   No inline credential: libpq reads the DB credential from PGPASSWORD or
#   ~/.pgpass, or inject the complete DATABASE_URL from your credential manager.
# DB_POOL_SIZE=10
# Single storage-mode seam — one knob cascades to every store backend it does not
# already set explicitly (unset = per-store defaults, byte-identical to today).
# STORAGE_MODE=postgres
# Per-store backend overrides: sqlite (default) | postgres.
# TRACE_BACKEND=sqlite
# EVIDENCE_BACKEND=sqlite
# CC_QUEUE_STORAGE_BACKEND=sqlite
# Postgres schema for traces (postgres backend only). Default: trace.
# TRACE_PG_SCHEMA=trace

# ── Vector search ──────────────────────────────────────────────────
# Default is brute_force (exact, in-memory). Switch to pgvector for ANN at scale.
# Requires DB_BACKEND=postgres and `pip install 'psycopg[binary]' pgvector`.
# VECTOR_BACKEND=pgvector
# VECTOR_DIMENSION=1536          # must match your embedding model output size
# PGVECTOR_IVF_LISTS=100         # rule of thumb: sqrt(expected_row_count)

# ── Keycloak / SSO (optional) ──────────────────────────────────────
# Set AUTH_PROVIDER accordingly and enable below to use Keycloak OIDC.
# KEYCLOAK_ENABLED=false
# KEYCLOAK_SERVER_URL=https://keycloak.example.com
# KEYCLOAK_REALM=your-realm
# KEYCLOAK_CLIENT_ID=agentos
# SECRET — do not commit a real value.
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_REDIRECT_URI=https://your-host/auth/oauth/callback
# KEYCLOAK_POST_LOGOUT_REDIRECT_URI=https://your-host/static/login.html
# Set false ONLY for a self-signed dev IdP.
# KEYCLOAK_VERIFY_SSL=true
# SSO session bounds (provider=keycloak users only):
# KEYCLOAK_SESSION_MAX_TTL_MINUTES=480
# KEYCLOAK_OFFLINE_SESSION_TTL_MINUTES=60
# KEYCLOAK_REACHABILITY_CACHE_SECONDS=30

# ── Route-level entitlements (optional, default OFF) ────────────────
# When disabled (default), route permission checks resolve to allow. Enable to make
# enterprise_root/tenants/${TENANT_ID}/security/policies.yaml authoritative.
# NOTE: ENTITLEMENTS_FAIL_CLOSED defaults true — enabling against an empty/missing
# policy file denies everything. Verify per role before cutover.
# ENTITLEMENTS_ENABLED=false
# ENTITLEMENTS_PROVIDER=yaml
# ENTITLEMENTS_FAIL_CLOSED=true
# Enforcement mode: enforce (block denials) | observe (log would-deny, don't block).
# ENTITLEMENTS_ENFORCEMENT_MODE=enforce

# ── Auth store hardening (optional) ────────────────────────────────
# Fail closed when the configured shared store (postgres/redis) is unreachable
# instead of silently falling back to a per-instance SQLite store. Defaults strict
# when a shared backend is selected or TLS is in use; leave unset for local dev.
# AUTH_STORE_STRICT=true
# Auth cookie Secure flag. Leave unset to auto-enable only when TLS is in use;
# set false for plain-HTTP LAN/IP access, true to force HTTPS-only cookies.
# AUTH_COOKIE_SECURE=false

# ── Privacy notice & declaration gate (optional, default OFF) ──────
# First-login data-privacy notice the user must accept before access. When OFF
# (default), login/SSO is unchanged. Enable only when a deployment requires it.
# PRIVACY_ACK_REQUIRED=false
# PRIVACY_NOTICE_VERSION=1.0.0
# PRIVACY_NOTICE_TITLE=AgentOS — Data Privacy Notice & Declaration
# PRIVACY_NOTICE_PATH=                 # custom markdown body; empty = built-in default
# PRIVACY_ACK_EXEMPT_ROLES=            # comma-separated roles exempt (break-glass)

# ── HashiCorp Vault TLS (optional) ─────────────────────────────────
# Vault CONNECTIONS are configured per-connection in the Credentials UI. Only the
# TLS trust used to reach Vault belongs here. Leave VAULT_CA_BUNDLE blank on Windows
# to use the OS trust store; else point it at the Vault CA PEM bundle.
# VAULT_CA_BUNDLE=
# VAULT_SSL_VERIFY=true
# VAULT_ENABLED=false                  # legacy single global env-configured backend

# ── Observability & misc ───────────────────────────────────────────
# Flip the platform to DEBUG logging (hooks, httpx, model registry, OAuth, routing).
# IAF_DEBUG=0
# Override the app version shown on login/footer (default: repo-root `Version` file).
# APP_VERSION=
# Bearer token guarding the /metrics scrape endpoint. Empty (default) = open.
# METRICS_SCRAPE_TOKEN=
# Path to the RL capture SQLite DB. Empty (default) = disabled.
# RL_DB_PATH=
# Verify TLS for MCP connections (default true).
# MCP_SSL_VERIFY=true
# Node runtime + repo root used to launch vendored MCP *stdio* servers directly from
# the UI (avoids the Windows npx.cmd shim + first-run npm download). Consumed by the
# MCP/stdio launch layer (not the kernel) — set both on hosts that run stdio MCP servers.
# IAF_NODE_EXECUTABLE=C:\Program Files\nodejs\node.exe
# IAF_REPO_ROOT=E:\AgentOS
# Pin the Python interpreter for hook/shell subprocesses (useful on Windows/NSSM
# where bare python3.exe may not be on PATH).
# IAF_PYTHON_EXECUTABLE=
# Windows only: ignore console CTRL events so a reparse-point python3 stub or a
# stray console signal cannot deliver SIGINT and take the server down. Set 1 on Windows.
# IAF_IGNORE_CONSOLE_CTRL=1
# Base URL the Command Center cron feeder / ingest calls back on.
# STUDIO_URL=http://localhost:8081
# IAF_QUEUE_INGEST_URL=http://localhost:8081/api/queue/ingest

# --- Vision edge (vision_client.py) ---------------------------------------------
# Edge /decide endpoint used by vision skills.
# VISION_EDGE_URL=http://127.0.0.1:8799/decide
# Approved local frame-store root. Only frames that resolve inside this folder are
# read and inlined; any other image_ref is passed to the edge unchanged. When unset,
# nothing local is inlined.
# VISION_FRAME_ROOT=/app/vision_frames
