# Fernet-encrypted credential store for the 'company' tenant.
#
# Each entry's `key` or `token` is encrypted at rest using CREDENTIAL_MASTER_KEY
# from agent_os/config.env. NEVER commit the plaintext values OR this file
# with real entries — keep this .example as the schema reference only.
#
# Run `python3 onboarding/setup/setup_security_test.py` to populate the real file
# with the demo credentials needed for the security test suite.

example_api:
  type: api_key                       # api_key | bearer | basic
  key: "PLAINTEXT_KEY_WILL_BE_ENCRYPTED_ON_FIRST_SAVE"
  scope:                              # which skill names may use this credential
    - general
    - my_skill_name
  ttl: 3600                           # optional, seconds
  metadata:
    vendor: example_vendor
    base_url: https://api.example.com
    description: "What this credential is for"
